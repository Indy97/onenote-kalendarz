<?xml version="1.0" encoding="UTF-8"?>
<!-- Manifest wtyczki OneNote. Wszystkie adresy wskazują na GitHub Pages:
     https://indy97.github.io/onenote-kalendarz/ – jeśli hosting jest inny, zamień ten adres w całym pliku. -->
<OfficeApp xmlns="http://schemas.microsoft.com/office/appforoffice/1.1"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xmlns:bt="http://schemas.microsoft.com/office/officeappbasictypes/1.0"
           xmlns:ov="http://schemas.microsoft.com/office/taskpaneappversionoverrides"
           xsi:type="TaskPaneApp">
  <Id>9d508844-76f4-47d7-a68a-9a65de041633</Id>
  <Version>1.0.0.0</Version>
  <ProviderName>A. Cichocki</ProviderName>
  <DefaultLocale>pl-PL</DefaultLocale>
  <DisplayName DefaultValue="Kalendarz zadań"/>
  <Description DefaultValue="Kalendarz z zadaniami na każdy dzień, zapisywanymi w Microsoft To Do."/>
  <IconUrl DefaultValue="https://indy97.github.io/onenote-kalendarz/assets/icon-32.png"/>
  <HighResolutionIconUrl DefaultValue="https://indy97.github.io/onenote-kalendarz/assets/icon-64.png"/>
  <SupportUrl DefaultValue="https://indy97.github.io/onenote-kalendarz/"/>
  <AppDomains>
    <AppDomain>https://login.microsoftonline.com</AppDomain>
  </AppDomains>
  <Hosts>
    <Host Name="Notebook"/>
  </Hosts>
  <DefaultSettings>
    <SourceLocation DefaultValue="https://indy97.github.io/onenote-kalendarz/taskpane.html"/>
  </DefaultSettings>
  <Permissions>ReadWriteDocument</Permissions>
  <VersionOverrides xmlns="http://schemas.microsoft.com/office/taskpaneappversionoverrides" xsi:type="VersionOverridesV1_0">
    <Hosts>
      <Host xsi:type="Notebook">
        <DesktopFormFactor>
          <FunctionFile resid="Commands.Url"/>
          <ExtensionPoint xsi:type="PrimaryCommandSurface">
            <OfficeTab id="TabHome">
              <Group id="KalendarzGroup">
                <Label resid="Group.Label"/>
                <Icon>
                  <bt:Image size="16" resid="Icon.16"/>
                  <bt:Image size="32" resid="Icon.32"/>
                  <bt:Image size="80" resid="Icon.80"/>
                </Icon>
                <Control xsi:type="Button" id="KalendarzButton">
                  <Label resid="Button.Label"/>
                  <Supertip>
                    <Title resid="Button.Label"/>
                    <Description resid="Button.Tooltip"/>
                  </Supertip>
                  <Icon>
                    <bt:Image size="16" resid="Icon.16"/>
                    <bt:Image size="32" resid="Icon.32"/>
                    <bt:Image size="80" resid="Icon.80"/>
                  </Icon>
                  <Action xsi:type="ShowTaskpane">
                    <TaskpaneId>KalendarzPane</TaskpaneId>
                    <SourceLocation resid="Taskpane.Url"/>
                  </Action>
                </Control>
              </Group>
            </OfficeTab>
          </ExtensionPoint>
        </DesktopFormFactor>
      </Host>
    </Hosts>
    <Resources>
      <bt:Images>
        <bt:Image id="Icon.16" DefaultValue="https://indy97.github.io/onenote-kalendarz/assets/icon-16.png"/>
        <bt:Image id="Icon.32" DefaultValue="https://indy97.github.io/onenote-kalendarz/assets/icon-32.png"/>
        <bt:Image id="Icon.80" DefaultValue="https://indy97.github.io/onenote-kalendarz/assets/icon-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Commands.Url" DefaultValue="https://indy97.github.io/onenote-kalendarz/commands.html"/>
        <bt:Url id="Taskpane.Url" DefaultValue="https://indy97.github.io/onenote-kalendarz/taskpane.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Group.Label" DefaultValue="Kalendarz"/>
        <bt:String id="Button.Label" DefaultValue="Kalendarz zadań"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Button.Tooltip" DefaultValue="Otwórz kalendarz z zadaniami i przypomnieniami."/>
      </bt:LongStrings>
    </Resources>
  </VersionOverrides>
</OfficeApp>
